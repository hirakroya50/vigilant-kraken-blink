# Trusted Node-only Mac control plane. Never use VITE_ for privileged values.
# Do not paste credentials in chat. .env is Git-ignored.
GITHUB_REPOSITORY=hirakroya50/vigilant-kraken-blink
SAFI_GITHUB_APP_ID=
SAFI_GITHUB_INSTALLATION_ID=
# Absolute path OUTSIDE this repository; owner-only 0600 or 0400 RSA PEM.
SAFI_GITHUB_APP_PRIVATE_KEY_PATH=
# Optional limited development discovery ONLY, selected explicitly with --pat.
GITHUB_TOKEN=
VALKEY_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Stage B settings await the actual Product 007 contract, S3/IAM and hostname.
